#!/bin/sh
# Installs @NAME@ for this login only. No administrator password is needed.
#
#     ./install.sh            installs, or updates an earlier install
#     ./install.sh --remove   takes it out again; your budgets stay
#
# The app goes in ~/.local/opt/@SLUG@, and an entry in the app menu points at it.
# The entry also claims @SCHEME@:// links, so a click on an invite link opens
# this app at its invitation page.
# Budgets are kept apart from the app, in ~/.local/share/@NAME@ (or under
# $XDG_DATA_HOME when that is set), and sign-ins in
# the desktop keyring, so removing or updating the app never touches them.
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="$HOME/.local/opt/@SLUG@"
MENU_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
# Named after the app's ID, so the desktop matches the open window to this entry
# and its icon. Earlier versions named it @SLUG@.desktop; that one is removed.
ENTRY="$MENU_DIR/@APPID@.desktop"
OLD_ENTRY="$MENU_DIR/@SLUG@.desktop"

# Most desktops find the app that opens a type of link in a list kept beside
# the menu entries. update-desktop-database brings that list up to date, where
# it is installed.
refresh_links() {
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$MENU_DIR" 2>/dev/null || true
    fi
}

if [ "${1:-}" = "--remove" ]; then
    rm -rf "$APP_DIR"
    rm -f "$ENTRY" "$OLD_ENTRY" "$ICON_DIR/@SLUG@.svg"
    refresh_links
    echo "@NAME@ is removed. Your budgets are still in ${XDG_DATA_HOME:-$HOME/.local/share}/@NAME@."
    exit 0
fi

mkdir -p "$APP_DIR" "$MENU_DIR" "$ICON_DIR"
# Replaced whole, so nothing from an older version is left behind.
rm -rf "$APP_DIR"
mkdir -p "$APP_DIR"
cp "$HERE/@SLUG@" "$APP_DIR/"
cp -R "$HERE/WellSpentLinux_WellSpentLinux.resources" "$APP_DIR/"
cp "$HERE/@SLUG@.svg" "$ICON_DIR/@SLUG@.svg"
rm -f "$OLD_ENTRY"

# %u is where the desktop puts a clicked link. The app's path goes in quotes
# only when it has a space or another sign that needs them. xdg-open, on a
# desktop it does not know, cannot start an app whose path is quoted.
case "$APP_DIR" in
    *[![:alnum:]/._-]*) EXEC="\"$APP_DIR/@SLUG@\"" ;;
    *) EXEC="$APP_DIR/@SLUG@" ;;
esac

cat > "$ENTRY" <<EOF
[Desktop Entry]
Type=Application
Name=@NAME@
Comment=Budgets you share
Exec=$EXEC %u
Icon=@SLUG@
StartupWMClass=@APPID@
Terminal=false
Categories=Office;Finance;
MimeType=x-scheme-handler/@SCHEME@;
EOF
refresh_links

echo "@NAME@ is installed. It is in the app menu."
