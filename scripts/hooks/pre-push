#!/bin/sh
# Runs the project's local checks before every push (the rule of 2026-10-22:
# everything but the UI tests runs on the engineer's own machine first). A
# failing check refuses the push. Installed by `make hooks`. To push without
# it, for a branch that only holds documents, say: SKIP_PREPUSH=1 git push
set -u
if [ "${SKIP_PREPUSH:-}" = "1" ]; then
    echo "pre-push: skipped by SKIP_PREPUSH=1" >&2
    exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
# Git runs hooks with GIT_DIR and its kin set. Left in place, every git call
# under make prepush goes to this repository: Xcode's package checkouts fail,
# and a script that makes a throwaway repository writes into this one. Clear
# git's own list of them, now that the top level is found.
unset $(git rev-parse --local-env-vars)
# What is being pushed, one line per ref: local ref, local sha, remote ref,
# remote sha. A delete has an all-zero local sha. A push that only deletes
# sends no commit, so there is nothing to check.
pushed="$(cat)"
sends_commit=""
for local_sha in $(printf '%s\n' "$pushed" | while read -r _ sha _ _; do echo "$sha"; done); do
    case "$local_sha" in *[!0]*) sends_commit=1 ;; esac
done
if [ -z "$sends_commit" ]; then
    echo "pre-push: this push only deletes, so there is nothing to check" >&2
    exit 0
fi
# A machine with no Swift on the host, such as a Linux box that builds in
# containers, runs the same checks with the Swift half in the Linux UI test
# image (scripts/prepush-in-docker.sh). That copy is HEAD, so only a push of
# HEAD is let through: anything else would go out with checks run on
# something else.
if ! command -v swift >/dev/null 2>&1 && command -v docker >/dev/null 2>&1; then
    head="$(git rev-parse HEAD)"
    for local_sha in $(printf '%s\n' "$pushed" | while read -r _ sha _ _; do echo "$sha"; done); do
        case "$local_sha" in *[!0]*) ;; *) continue ;; esac
        if [ "$local_sha" != "$head" ]; then
            echo "pre-push: this push sends $local_sha, but HEAD is $head. Check out what you push, so the checks test it." >&2
            exit 1
        fi
    done
    echo "pre-push: no swift here, so make prepush's Swift half runs in a container (SKIP_PREPUSH=1 skips it)" >&2
    exec scripts/prepush-in-docker.sh
fi
echo "pre-push: running make prepush (about 25 minutes on a Mac; SKIP_PREPUSH=1 skips it)" >&2
exec make prepush
