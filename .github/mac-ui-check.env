# Proof run for the Mac lock tests: the app's plan and lock classes, and the
# locked-house test from Properties main. Every class here shares the run's
# two staging accounts. LockTests deletes its groups even when it fails; the
# order, with LockTests last, is only a backstop for that.
CLASSES="PlanTests HouseLockTests LockTests"
PROPERTIES_REF="main"
